<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailBackButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="←"
                android:textColor="#006341"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/detailCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="কাস্টমারের নাম"
                android:textColor="#183A29"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailMenuButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="#006341"
                android:textSize="25sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="টাকা পাবো"
                android:textColor="#647067"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detailCustomerDue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="৳ ০"
                android:textColor="#006341"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/detailReportButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:text="রিপোর্ট"
                android:textColor="#006341"
                android:backgroundTint="#E1F4E7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/detailAddButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="৳ বাকি +"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#006341"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/detailReceiveButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="৳ পেলাম −"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#E1F4E7"
                android:textColor="#006341" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="টাকার পরিমাণ (৳)"
            android:textColor="#26382D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/detailAmount"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#FFFFFF"
            android:hint="টাকার পরিমাণ লিখুন"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="#006341"
            android:textSize="21sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="তারিখ:"
            android:textColor="#26382D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/detailDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#FFFFFF"
            android:focusable="false"
            android:clickable="true"
            android:hint="তারিখ নির্বাচন করুন"
            android:textColor="#183A29" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="বিবরণ:"
            android:textColor="#26382D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/detailNote"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:hint="কী কারণে টাকা যোগ/জমা হলো?"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="#183A29" />

        <Button
            android:id="@+id/detailConfirmButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="নিশ্চিত করুন"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#078047" />

    </LinearLayout>
</ScrollView>
