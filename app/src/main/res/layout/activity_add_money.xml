<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addMoneyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#006341">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/addMoneyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:text="টাকা যোগ করুন"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নতুন বাকি হিসাব"
                android:textColor="#183A29"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="দেওয়া বাকি তথ্য লিখুন"
                android:textColor="#647067"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="১. কাস্টমারের নাম *"
                android:textColor="#26382D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/customerName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#FFFFFF"
                android:hint="কাস্টমারের নাম লিখুন"
                android:singleLine="true"
                android:inputType="textPersonName"
                android:textColor="#183A29"
                android:textColorHint="#89948C" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="২. টাকার পরিমাণ (৳) *"
                android:textColor="#26382D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/moneyAmount"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#FFFFFF"
                android:hint="পূর্বের বাকি (জের)"
                android:singleLine="true"
                android:inputType="numberDecimal"
                android:textColor="#006341"
                android:textColorHint="#89948C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="৩. তারিখ"
                android:textColor="#26382D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/moneyDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#FFFFFF"
                android:singleLine="true"
                android:focusable="false"
                android:clickable="true"
                android:hint="তারিখ নির্বাচন করুন"
                android:textColor="#183A29" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="৪. বিবরণ (ঐচ্ছিক)"
                android:textColor="#26382D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/moneyNote"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:padding="14dp"
                android:gravity="top"
                android:background="#FFFFFF"
                android:hint="কী বাবদ টাকা বাকি দিলেন?"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="#183A29"
                android:textColorHint="#89948C" />

            <Button
                android:id="@+id/saveMoneyButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="✓  সেভ করুন"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#078047" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="* চিহ্নিত তথ্য অবশ্যই দিতে হবে"
                android:textColor="#647067"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
